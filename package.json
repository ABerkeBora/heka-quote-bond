{
  "name": "quote-bond",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build --config vite.config.js",
    "start": "NODE_ENV=production node server/index.mjs",
    "contracts:build": "forge build",
    "test": "node --test test/*.test.mjs",
    "test:contracts": "forge test -vv",
    "deploy": "node scripts/deploy.mjs",
    "evidence": "node scripts/live-evidence.mjs",
    "submit-response": "node scripts/submit-response.mjs",
    "recover-lock": "node scripts/recover-lock.mjs",
    "judge:prepare": "node scripts/prepare-judge.mjs",
    "wallets:init": "node scripts/init-wallets.mjs",
    "v2:wallets:init": "node scripts/v2-init-wallets.mjs",
    "v2:fund-gas": "node scripts/v2-fund-gas.mjs",
    "v2:deploy": "node scripts/v2-deploy.mjs",
    "v2:recover-lock": "node scripts/v2-recover-lock.mjs",
    "v2:evidence": "node scripts/v2-evidence.mjs",
    "v2:submit-response": "node scripts/v2-submit-response.mjs",
    "v2:judge:prepare": "node scripts/v2-judge-prepare.mjs",
    "v2:verify": "node scripts/v2-verify-deployment.mjs",
    "v2:regression": "node scripts/v2-regression.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "express": "5.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "solady": "0.1.26",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "vite": "7.3.7"
  }
}
