# Only Base Sepolia, chain ID 84532. Never use real-value funds.
RPC_URL=https://sepolia.base.org
# Create isolated keys with npm run wallets:init; this file must remain ignored and 0600.
WALLET_FILE=.local/wallets.json

# Separate V2 wallets; never point this at a V1 wallet file.
V2_WALLET_FILE=.local/v2/wallets.json
